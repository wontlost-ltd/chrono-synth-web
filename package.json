{
  "name": "chrono-synth-web",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "setup": "sh scripts/setup-packages.sh",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --configLoader runner",
    "test:watch": "vitest --configLoader runner",
    "test:ops": "sh -n scripts/render-runtime-config.sh && sh -n docker-entrypoint.sh && TMP_FILE=$(mktemp) && RUNTIME_CONFIG_OUTPUT=\"$TMP_FILE\" CHRONO_WEB_API_BASE_URL=https://api.example.test CHRONO_WEB_SENTRY_DSN=https://dsn.example.test/1 CHRONO_WEB_ENVIRONMENT=staging sh scripts/render-runtime-config.sh && grep -q 'https://api.example.test' \"$TMP_FILE\" && grep -q 'staging' \"$TMP_FILE\" && rm -f \"$TMP_FILE\"",
    "lhci": "npx @lhci/cli@latest autorun"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/context-zone": "^2.7.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.205.0",
    "@opentelemetry/resources": "^2.7.1",
    "@opentelemetry/sdk-trace-web": "^2.7.1",
    "@opentelemetry/semantic-conventions": "^1.40.0",
    "@sentry/react": "^10.39.0",
    "@tanstack/react-query": "^5.72.2",
    "@tanstack/react-virtual": "^3.13.18",
    "d3-sankey": "^0.12.3",
    "i18next": "^25.8.10",
    "i18next-browser-languagedetector": "^8.2.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-i18next": "^16.5.4",
    "react-router-dom": "^7.5.0",
    "recharts": "^2.15.3",
    "web-vitals": "^5.1.0"
  },
  "overrides": {
    "serialize-javascript": "^7.0.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.1",
    "@chrono/contracts": "file:packages/contracts",
    "@chrono/design-tokens": "file:packages/design-tokens",
    "@chrono/kernel-testkit": "file:packages/kernel-testkit",
    "@chrono/sync-engine": "file:packages/sync-engine",
    "@playwright/test": "^1.58.2",
    "@tailwindcss/vite": "^4.1.4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/d3-sankey": "^0.12.4",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^6.0.1",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^28.1.0",
    "tailwindcss": "^4.1.4",
    "typescript": "^5.8.3",
    "vite": "^8.0.10",
    "vite-plugin-pwa": "^1.2.0",
    "vitest": "^4.1.5"
  }
}
